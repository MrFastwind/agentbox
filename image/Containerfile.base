# Shared base for every agentbox sandbox.
#
# The shipped image is FROM scratch: it contains only the musl runtime and the
# commands the sandbox itself needs, with no package manager, package database
# or compiler. The tools are assembled in an Alpine builder stage and copied in,
# so the final layer cannot be extended at runtime.
#
# Alpine, not Debian: the agents ship musl builds, and their copied libraries
# must match the runtime in the final image. Both stages use the same pinned
# Alpine image, so the ldd closure assembled below is the one that actually runs.
#
# The tag is pinned by digest. "3.22" moves, and an image built once and trusted
# for a long time should not change underneath a rebuild. Bump the digest and
# the matching package set together.
ARG ALPINE_IMAGE

FROM ${ALPINE_IMAGE} AS tools

# busybox supplies the POSIX shell and the small coreutils the entrypoint uses.
# coreutils supplies install(1), which the vendor installers use. The remaining
# tools are the smallest set the agents and a coding shell actually need.
RUN apk add --no-cache \
      bash \
      busybox-static \
      ca-certificates \
      coreutils \
      curl \
      git \
      jq \
      less \
      musl-utils \
      ncurses-terminfo-base \
      procps-ng \
      ripgrep \
      xz

# Assemble a root filesystem containing only the runtime files. Do not copy the
# Alpine package database, docs, or apk itself: they are not needed and would
# undo the size and attack-surface reduction.
RUN set -eu; \
    mkdir -p \
      /out/bin \
      /out/lib \
      /out/usr/bin \
      /out/usr/lib \
      /out/usr/libexec/git-core \
      /out/usr/local/bin \
      /out/usr/share \
      /out/etc/ssl/certs \
      /out/home/agent \
      /out/workspace \
      /out/tmp \
      /out/run/agentbox/seeds; \
    chmod 1777 /out/tmp; \
    /bin/busybox --install -s /out/bin; \
    cp -fL /bin/busybox /out/bin/busybox; \
    for f in /bin/bash /bin/ps /usr/bin/curl /usr/bin/git /usr/bin/install /usr/bin/jq /usr/bin/less /usr/bin/rg; do \
      [ -e "$f" ] || continue; \
      cp -Lf "$f" /out/usr/bin/; \
      ldd "$f" 2>/dev/null \
        | awk '/=> \// {print $3} /^\// {print $1}' \
        | while read -r lib; do [ -e "$lib" ] && cp --parents -L "$lib" /out; done; \
    done; \
    # git-core helpers (notably git-remote-https) are separate ELF files and
    # need their own libraries. Scripts simply produce no ldd output.
    for f in /usr/libexec/git-core/*; do \
      [ -e "$f" ] || continue; \
      ldd "$f" 2>/dev/null \
        | awk '/=> \// {print $3} /^\// {print $1}' \
        | while read -r lib; do [ -e "$lib" ] && cp --parents -L "$lib" /out; done; \
    done; \
    for lib in /lib/ld-musl-*.so.1; do \
      [ -e "$lib" ] || continue; \
      cp -Lf "$lib" /out/lib/; \
    done; \
    cp -a /usr/libexec/git-core/. /out/usr/libexec/git-core/; \
    if [ -d /usr/share/git-core ]; then cp -a /usr/share/git-core /out/usr/share/; fi; \
    cp -a /usr/share/terminfo /out/usr/share/; \
    cp -a /etc/ssl/certs /out/etc/ssl/; \
    for f in /etc/ssl/cert.pem /etc/ssl/ca-certificates.crt; do \
      [ -e "$f" ] || continue; \
      cp -a "$f" /out/etc/ssl/; \
    done; \
    printf '%s\n' \
      'root:x:0:0:root:/root:/bin/sh' \
      'agent:x:1000:1000:agent:/home/agent:/bin/bash' \
      > /out/etc/passwd; \
    printf '%s\n' \
      'root:x:0:' \
      'agent:x:1000:' \
      > /out/etc/group

FROM scratch

COPY --from=tools /out/ /
COPY entrypoint.sh /usr/local/bin/agentbox-entrypoint

# Fail the build if a copied binary is missing a library or the shell cannot
# start. This is the check that catches an incomplete ldd copy.
RUN ["/bin/busybox", "sh", "-c", "/bin/chmod 0755 /usr/local/bin/agentbox-entrypoint && /bin/bash --version >/dev/null && /usr/bin/curl --version >/dev/null && /usr/bin/git --version >/dev/null && test -x /usr/libexec/git-core/git-remote-https && /usr/bin/rg --version >/dev/null && /usr/bin/less --version >/dev/null && /usr/bin/install --version >/dev/null && /usr/bin/jq --version >/dev/null && /bin/busybox ps >/dev/null"]

# /workspace is where the launch directory is mounted. The other writable
# directories (HOME, state, seeds) are mounted by the session, not baked in.
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/agentbox-entrypoint"]
CMD ["/bin/bash", "-l"]
