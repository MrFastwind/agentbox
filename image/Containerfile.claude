# claude sandbox: slim base + the Claude Code native binary.
#
# Claude Code ships a self-contained binary, so no Node runtime is needed. The
# vendor installer is not used here: it resolves "latest" before installing even
# when a version argument is present, which makes the resulting image depend on
# whatever upstream published that day. Downloading the versioned artifact and
# checking its digest keeps the image reproducible.
ARG BASE=localhost/agentbox/base:latest
FROM ${BASE}

ARG CLAUDE_VERSION=2.1.325

# Digests from the per-version manifest:
# https://downloads.claude.ai/claude-code-releases/<version>/manifest.json
# Bump the version, both digests, and the smoke test together.
ARG CLAUDE_SHA256_X64=0dc4f4a9a165fc60746d7ae8489712e5fc352f1e7ad4eb22e7141bd0812eb0cf
ARG CLAUDE_SHA256_ARM64=7b6e484b1989a5a14a4b354709ccc8672518a3ec5b9ccd7981fc6254327fde67

RUN ARCH="$(uname -m)" \
 && case "$ARCH" in \
      x86_64|amd64) CLAUDE_ARCH=x64;   CLAUDE_SHA256="$CLAUDE_SHA256_X64" ;; \
      aarch64|arm64) CLAUDE_ARCH=arm64; CLAUDE_SHA256="$CLAUDE_SHA256_ARM64" ;; \
      *) echo "unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/claude \
      "https://downloads.claude.ai/claude-code-releases/${CLAUDE_VERSION}/linux-${CLAUDE_ARCH}/claude" \
 && echo "${CLAUDE_SHA256}  /tmp/claude" | sha256sum -c - \
 && chmod 0755 /tmp/claude \
 && mkdir -p /opt/claude \
 && HOME=/opt/claude /tmp/claude install \
 && ln -sf /opt/claude/.local/bin/claude /usr/local/bin/claude \
 && rm -f /tmp/claude

# The binary updates itself in the background by default. An immutable image
# cannot persist an update, and a half-updated launcher is worse than a stale
# one, so updates are disabled. (DISABLE_UPDATES also blocks "claude install".)
ENV DISABLE_AUTOUPDATER=1

# Fail the build rather than shipping an image whose agent cannot start, or one
# whose version drifted from the pin.
RUN claude --version | grep -F "${CLAUDE_VERSION}"

ENTRYPOINT ["/usr/local/bin/agentbox-entrypoint"]
CMD ["claude"]
