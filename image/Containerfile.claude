# claude sandbox: slim base + the Claude Code native binary.
#
# Claude Code ships a self-contained binary, so no Node runtime is needed. The
# vendor installer is not used here: it resolves "latest" before installing even
# when a version argument is present, which makes the resulting image depend on
# whatever upstream published that day. Downloading the versioned tarball and
# checking its digest keeps the image reproducible.
ARG BASE=localhost/agentbox/base:latest
FROM ${BASE}

ARG CLAUDE_VERSION
ARG CLAUDE_SHA256_X64
ARG CLAUDE_SHA256_ARM64

RUN set -eu; \
    test -n "${CLAUDE_VERSION}"; \
    case "$(uname -m)" in \
      x86_64|amd64) ARCH=x64; SUM="${CLAUDE_SHA256_X64}" ;; \
      aarch64|arm64) ARCH=arm64; SUM="${CLAUDE_SHA256_ARM64}" ;; \
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    test -n "${SUM}"; \
    curl -fsSL --retry 3 \
      "https://github.com/anthropics/claude-code/releases/download/v${CLAUDE_VERSION}/claude-linux-${ARCH}-musl.tar.gz" \
      -o /tmp/claude.tar.gz; \
    printf '%s  %s\n' "${SUM}" /tmp/claude.tar.gz | sha256sum -c -; \
    tar -xzf /tmp/claude.tar.gz -C /usr/local/bin claude; \
    chmod 0755 /usr/local/bin/claude; \
    rm -f /tmp/claude.tar.gz

# Fail the build rather than shipping an image whose agent cannot start, or one
# whose version drifted from the pin.
RUN claude --version | grep -F "${CLAUDE_VERSION}"

ENTRYPOINT ["/usr/local/bin/agentbox-entrypoint"]
CMD ["claude"]
