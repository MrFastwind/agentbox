# opencode sandbox: base + the opencode binary.
#
# Deliberately carries no Node runtime. opencode is a self-contained native
# binary, and bundling Node for pi's sake would make every opencode user pay for
# a runtime they never invoke.
ARG BASE=localhost/agentbox/base:latest
FROM ${BASE}

# Pin this. An unpinned agent install means the sandbox image changes underneath
# the user, and the reviewed version is not the running version.
ARG OPENCODE_VERSION=latest

# The upstream installer places the binary under $HOME/.opencode/bin. Verify the
# installer's flags against the pinned version when bumping, and prefer a pinned
# release artifact over "latest" once a version is chosen.
RUN curl -fsSL https://opencode.ai/install | bash \
 && cp -a /root/.opencode/bin/. /usr/local/bin/ \
 && rm -rf /root/.opencode

# Fail the build rather than shipping an image whose agent cannot start.
RUN opencode --version

ENTRYPOINT ["/usr/local/bin/agentbox-entrypoint"]
CMD ["opencode"]
