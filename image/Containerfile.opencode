# opencode sandbox: slim base + the opencode binary.
#
# Deliberately carries no Node runtime. opencode is a self-contained native
# binary, and bundling Node for pi's sake would make every opencode user pay for
# a runtime they never invoke.
#
# Versions and digests are injected from image/pins.yaml. A missing build arg is
# a build error; there is intentionally no floating default here.
ARG BASE=localhost/agentbox/base:latest
FROM ${BASE}

ARG OPENCODE_VERSION
ARG OPENCODE_SHA256_X64
ARG OPENCODE_SHA256_ARM64

RUN set -eu; \
    test -n "${OPENCODE_VERSION}"; \
    case "$(uname -m)" in \
      x86_64|amd64) ARCH=x64; SUM="${OPENCODE_SHA256_X64}" ;; \
      aarch64|arm64) ARCH=arm64; SUM="${OPENCODE_SHA256_ARM64}" ;; \
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    test -n "${SUM}"; \
    curl -fsSL --retry 3 \
      "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-linux-${ARCH}.tar.gz" \
      -o /tmp/opencode.tar.gz; \
    printf '%s  %s\n' "${SUM}" /tmp/opencode.tar.gz | sha256sum -c -; \
    tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin opencode; \
    chmod 0755 /usr/local/bin/opencode; \
    rm -f /tmp/opencode.tar.gz

# Fail the build rather than shipping an image whose agent cannot start, or one
# whose version drifted from the pin.
RUN opencode --version | grep -F "${OPENCODE_VERSION}"

ENTRYPOINT ["/usr/local/bin/agentbox-entrypoint"]
CMD ["opencode"]
