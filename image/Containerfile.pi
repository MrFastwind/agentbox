# pi sandbox: base + Node + the pi coding agent.
#
# pi is an npm package (engines.node >= 22.19.0), not a static binary, so this
# image carries a Node runtime. It is a separate image from opencode's precisely
# so that Node is not paid for twice.
ARG BASE=localhost/agentbox/base:latest
FROM ${BASE}

# Pinned. The image's Node must satisfy the pinned pi version's engines field;
# drifting either one independently is a real failure mode.
ARG NODE_VERSION=26.13.1
ARG PI_VERSION=1.5.2

# The tarball is verified against a digest pinned here, not merely fetched over
# TLS from the same host that serves it. Without this, a compromise of the
# download (or of nodejs.org) yields an image that silently runs attacker code,
# and the image is built once and then trusted for a long time. Bumping
# NODE_VERSION therefore also requires bumping the matching digest: from
# https://nodejs.org/dist/v<version>/SHASUMS256.txt.
ARG NODE_SHA256_X64=5c063e46bab0fbc1c17cc445d7ff129cbdcd0471be6ed83b6ab864f8143bc864
ARG NODE_SHA256_ARM64=89e1853138db51e8b82d3e98ba9c0d3f2956a28e5e55ea1b7e12d25aae92d5dd

RUN ARCH="$(dpkg --print-architecture)" \
 && case "$ARCH" in \
      amd64) NODE_ARCH=x64;   NODE_SHA256="$NODE_SHA256_X64" ;; \
      arm64) NODE_ARCH=arm64; NODE_SHA256="$NODE_SHA256_ARM64" ;; \
      *) echo "unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
 && echo "${NODE_SHA256}  node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" | sha256sum -c - \
 && tar -xJf "node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
      -C /usr/local --strip-components=1 --no-same-owner \
 && rm "node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
 && node --version \
 && npm --version

# The agent package itself comes from a tarball verified against a digest pinned
# here. npm also checks the registry's signed integrity metadata, but pinning the
# digest in the repository means a registry compromise that swaps the tarball and
# rewrites its metadata is still caught. Transitive dependencies are still
# resolved from the registry and are not pinned here.
ARG PI_SHA512_HEX=994588d38aea17555dfe6d6af8fb355de5ac4d7115bd1527b2645af372370f3b9ad13c796d84bdde299eaad21fad77fb3e491a47a111cfe02e4212099689b9c8

RUN curl -fsSL -o /tmp/pi.tgz \
      "https://registry.npmjs.org/@earendil-works/pi-coding-agent/-/pi-coding-agent-${PI_VERSION}.tgz" \
 && echo "${PI_SHA512_HEX}  /tmp/pi.tgz" | sha512sum -c - \
 && npm install --global --omit=dev /tmp/pi.tgz \
 && rm -f /tmp/pi.tgz \
 && npm cache clean --force

# Fail the build rather than shipping an agent that cannot resolve its runtime.
RUN pi --version

ENTRYPOINT ["/usr/local/bin/agentbox-entrypoint"]
CMD ["pi"]
