# pi sandbox: base + Node + the pi coding agent.
#
# pi is an npm package (engines.node >= 22.19.0), not a static binary, so this
# image needs a Node runtime. Node and pi are installed in an Alpine builder
# stage and only the musl runtime files are copied into the scratch base; npm,
# the package cache, docs and examples never reach the final image.
ARG BASE=localhost/agentbox/base:latest
ARG ALPINE_IMAGE

FROM ${ALPINE_IMAGE} AS build

# Only this stage needs these: the official Node tarball is .tar.xz, and the
# musl binary links libstdc++ and libgcc. The other agents do not pay for pi's
# build dependencies or runtime.
RUN apk add --no-cache \
      ca-certificates \
      curl \
      libgcc \
      libstdc++ \
      musl-utils \
      tar \
      xz

# Pinned. The image's Node must satisfy the pinned pi version's engines field;
# drifting either one independently is a real failure mode.
ARG NODE_VERSION
ARG PI_VERSION

# The tarball is verified against a digest pinned here, not merely fetched over
# TLS from the same host that serves it. Without this, a compromise of the
# download (or of nodejs.org) yields an image that silently runs attacker code,
# and the image is built once and then trusted for a long time. Bumping
# NODE_VERSION therefore also requires bumping the matching digest: from
# https://nodejs.org/dist/v<version>/SHASUMS256.txt for x64, or from
# https://unofficial-builds.nodejs.org/download/release/v<version>/SHASUMS256.txt
# for the arm64 musl build that nodejs.org does not publish.
ARG NODE_SHA256_X64
ARG NODE_SHA256_ARM64

RUN test -n "${NODE_VERSION}" && test -n "${NODE_SHA256_X64}" && test -n "${NODE_SHA256_ARM64}" \
 && ARCH="$(uname -m)" \
 && case "$ARCH" in \
      x86_64|amd64) NODE_ARCH=x64;   NODE_HOST=https://nodejs.org/dist; NODE_SHA256="$NODE_SHA256_X64" ;; \
      aarch64|arm64) NODE_ARCH=arm64; NODE_HOST=https://unofficial-builds.nodejs.org/download/release; NODE_SHA256="$NODE_SHA256_ARM64" ;; \
      *) echo "unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSLO "${NODE_HOST}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}-musl.tar.xz" \
 && echo "${NODE_SHA256}  node-v${NODE_VERSION}-linux-${NODE_ARCH}-musl.tar.xz" | sha256sum -c - \
 && tar -xJf "node-v${NODE_VERSION}-linux-${NODE_ARCH}-musl.tar.xz" \
      -C /usr/local --strip-components=1 --no-same-owner \
 && rm "node-v${NODE_VERSION}-linux-${NODE_ARCH}-musl.tar.xz" \
 && node --version \
 && npm --version

# The agent package itself comes from a tarball verified against a digest pinned
# here. npm also checks the registry's signed integrity metadata, but pinning the
# digest in the repository means a registry compromise that swaps the tarball and
# rewrites its metadata is still caught. Transitive dependencies are still
# resolved from the registry and are not pinned here.
ARG PI_SHA512_HEX

RUN test -n "${PI_VERSION}" && test -n "${PI_SHA512_HEX}" \
 && curl -fsSL -o /tmp/pi.tgz \
      "https://registry.npmjs.org/@earendil-works/pi-coding-agent/-/pi-coding-agent-${PI_VERSION}.tgz" \
 && echo "${PI_SHA512_HEX}  /tmp/pi.tgz" | sha512sum -c - \
 && npm install --global --omit=dev /tmp/pi.tgz \
 && rm -f /tmp/pi.tgz \
 && npm cache clean --force

# Assemble only the runtime: the node binary, the pi package and its launcher,
# and the shared libraries node links against. npm itself (~19 MB), docs and
# examples are deliberately left in the builder stage.
RUN set -eu; \
    rm -rf /usr/local/lib/node_modules/@earendil-works/pi-coding-agent/docs \
           /usr/local/lib/node_modules/@earendil-works/pi-coding-agent/examples; \
    mkdir -p /out/usr/local/bin /out/usr/local/lib/node_modules; \
    cp /usr/local/bin/node /out/usr/local/bin/node; \
    ln -sf ../lib/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js \
      /out/usr/local/bin/pi; \
    cp -a /usr/local/lib/node_modules/@earendil-works /out/usr/local/lib/node_modules/; \
    ldd /usr/local/bin/node 2>/dev/null \
      | awk '/=> \// {print $3} /^\// {print $1}' \
      | while read -r lib; do [ -e "$lib" ] && cp --parents -L "$lib" /out; done

FROM ${BASE}

COPY --from=build /out/ /

# Fail the build rather than shipping an agent that cannot resolve its runtime.
RUN ["/bin/busybox", "sh", "-c", "node --version && pi --version"]

ENTRYPOINT ["/usr/local/bin/agentbox-entrypoint"]
CMD ["pi"]
